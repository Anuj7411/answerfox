# Answerfox web app environment variables.
# Copy to `.env.local` and fill in values from your Supabase project.

# --- Supabase ---

# Pooled (transaction-mode) Postgres connection string.
# Used by the app at runtime (query workloads, Edge Functions).
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (transaction mode)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Direct (session-mode) Postgres connection string.
# Used by drizzle-kit for DDL migrations. Bypasses the pooler.
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (direct connection)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.compute.amazonaws.com:5432/postgres"

# Public anon key (safe to expose in browser).
# Get from: Supabase Dashboard → Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Service role key (server-only, NEVER expose to browser).
# Get from: Supabase Dashboard → Project Settings → API → Project API keys → service_role secret
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- GitHub App (AnswerFox fix-PRs; relaunch week 1) ---

# From the App's settings page after registering it (unlisted App).
# GITHUB_APP_ID=""
# PEM private key. Keep the literal \n escapes if storing single-line.
# GITHUB_APP_PRIVATE_KEY=""
# Webhook secret you chose at App registration.
# GITHUB_WEBHOOK_SECRET=""

# --- Inngest (PR queue; free tier) ---

# Not needed for local dev (`npx inngest-cli dev` runs keyless).
# Required when connected to Inngest Cloud in production.
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# --- Observability ---

# PostHog product analytics (optional in local dev, silent no-op when unset).
# Get from: https://us.posthog.com → Project Settings → API keys
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Sentry error tracking (wired in a later PR).
# SENTRY_DSN=""

# --- Local dev auth bypass (NEVER set on Vercel / production) ---
# When DEV_AUTH_BYPASS=true on a local dev machine (`next dev`), the Supabase
# client impersonates a real profile from the DB so every authed page renders
# with real data without a Supabase login (email auth is off; OAuth can't run
# headlessly). Triple-gated in code: ignored unless not on Vercel AND not a
# production build. Optionally pin a specific user with DEV_AUTH_USER_ID.
# DEV_AUTH_BYPASS="true"
# DEV_AUTH_USER_ID="<a profiles.id uuid>"